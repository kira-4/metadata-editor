# Environment variables
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Model used for metadata inference (any OpenRouter model id).
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional comma-separated backup models, tried in order if the primary fails.
# OPENROUTER_FALLBACK_MODELS=anthropic/claude-haiku-4-5,openai/gpt-4o-mini

# Optional: override the OpenRouter base URL (defaults to https://openrouter.ai/api/v1).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

APP_NAME=محرر الأصوات الولائية

# Deleted queue items keep their original in data/trash/{id}/ for this many days.
# To restore one, move the file back into the incoming folder.
# TRASH_RETENTION_DAYS=30

# Host user/group that owns the music library (check with `ls -ln`).
# Files moved into /music are created with this owner. Defaults to 1000:1000.
# If upgrading from a root-run container, fix existing files once:
#   sudo chown -R 1000:1000 ./data ./music
PUID=1000
PGID=1000
